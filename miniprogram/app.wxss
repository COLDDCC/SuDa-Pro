page {
  background: #f5f6fa;
  color: #1f2330;
  font-size: 28rpx;
  box-sizing: border-box;
}

.container {
  padding: 24rpx;
}

.card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(20, 30, 60, 0.05);
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
  color: #1f2330;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.muted {
  color: #8a8f9c;
  font-size: 24rpx;
}

.btn-primary {
  background: #2b6cff;
  color: #fff;
  border-radius: 44rpx;
  font-size: 30rpx;
  line-height: 88rpx;
  height: 88rpx;
}

.btn-outline {
  background: #fff;
  color: #2b6cff;
  border: 2rpx solid #2b6cff;
  border-radius: 44rpx;
  font-size: 28rpx;
  line-height: 72rpx;
  height: 72rpx;
}

.input {
  background: #f5f6fa;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  font-size: 28rpx;
}

.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
}

.tag-pending { background: #fff4e5; color: #d97706; }
.tag-inbound { background: #e6f4ff; color: #1677ff; }
.tag-ordered { background: #eef2ff; color: #4f46e5; }
.tag-shipped { background: #e7f8ee; color: #12a150; }
.tag-cancelled, .tag-closed { background: #f2f2f2; color: #999; }

.empty {
  text-align: center;
  color: #b0b4bf;
  padding: 120rpx 0;
  font-size: 26rpx;
}

/* 表单里的开关行：左边文案右边开关，用于"到仓后帮我拍照"这类可选增值服务 */
.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-top: 2rpx solid #f0f1f5;
}

.switch-text {
  flex: 1;
  padding-right: 20rpx;
}

.switch-label {
  font-size: 28rpx;
  margin-bottom: 6rpx;
}

/* 输入框下面那行小字说明，比 .muted 更贴近上一个元素 */
.hint {
  color: #8a8f9c;
  font-size: 22rpx;
  margin: -12rpx 0 20rpx;
  line-height: 1.5;
}

/* 费用明细：每一条"名称 —— 金额"，外加算法说明 */
.fee-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 14rpx 0;
}

.fee-name {
  flex: 1;
  padding-right: 20rpx;
}

.fee-detail {
  color: #8a8f9c;
  font-size: 22rpx;
  margin-top: 4rpx;
}

.fee-amount {
  font-size: 28rpx;
  white-space: nowrap;
}

.fee-total {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 20rpx;
  margin-top: 8rpx;
  border-top: 2rpx solid #f0f1f5;
  font-weight: 600;
}

.fee-total-amount {
  color: #e8453c;
  font-size: 34rpx;
}

/* 包裹照片缩略图 */
.photo-strip {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.photo-thumb {
  width: 140rpx;
  height: 140rpx;
  border-radius: 10rpx;
  background: #f0f1f5;
}

/* 实际称重 vs 预报重量的对比行 */
.weight-row {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-top: 8rpx;
}

.weight-actual {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2330;
}

.weight-declared {
  color: #8a8f9c;
  font-size: 22rpx;
  text-decoration: line-through;
}
