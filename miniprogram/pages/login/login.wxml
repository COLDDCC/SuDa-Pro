<view class="container">
  <view class="card" style="margin-top: 120rpx; text-align: center;">
    <view style="font-size: 40rpx; font-weight: 700; margin-bottom: 12rpx;">XX转运Pro</view>
    <view class="muted">把日本买的东西，安心带回家</view>
  </view>

  <view class="card">
    <button class="btn-primary" bindtap="onWechatLogin">微信一键登录</button>
  </view>

  <view class="card">
    <view class="section-title">本地联调登录（无需微信凭证）</view>
    <input class="input" placeholder="随便填个用户名" value="{{devIdentifier}}" bindinput="onDevIdentifierInput" />
    <button class="btn-outline" bindtap="onDevLogin">测试登录</button>
  </view>
</view>
