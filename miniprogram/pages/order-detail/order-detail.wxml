<view class="container" wx:if="{{order}}">
  <view class="card row">
    <view class="muted">{{order.order_no}}</view>
    <view class="tag {{order.statusInfo.cls}}">{{order.statusInfo.text}}</view>
  </view>

  <view class="card" wx:if="{{order.inter_order}}">
    <view class="section-title">国际转运单号</view>
    <view>{{order.inter_order}}</view>
  </view>

  <view class="card">
    <view class="section-title">收件信息</view>
    <view>{{order.address.consigner}} {{order.address.mobile}}</view>
    <view class="muted">{{order.address.province}}{{order.address.city}}{{order.address.district}}{{order.address.address}}</view>
  </view>

  <view class="card">
    <view class="section-title">包裹清单（{{order.packages.length}}件）</view>
    <view wx:for="{{order.packages}}" wx:key="id" style="padding: 12rpx 0; border-top: 1rpx solid #f0f0f0;">
      <view class="row">
        <view>{{item.good_name}}</view>
        <view class="tag {{item.statusInfo.cls}}">{{item.statusInfo.text}}</view>
      </view>
      <view class="muted">
        计费重量 {{item.actual_weight}}kg<block wx:if="{{item.netwt != item.actual_weight}}">（预报 {{item.netwt}}kg）</block>
      </view>
      <view class="photo-strip" wx:if="{{item.hasPhotos}}">
        <image wx:for="{{item.photoUrls}}" wx:for-item="url" wx:key="*this"
          class="photo-thumb" src="{{url}}" mode="aspectFill"
          data-urls="{{item.photoUrls}}" data-current="{{url}}" bindtap="onPreviewPhoto" />
      </view>
    </view>
  </view>

  <view class="card">
    <view class="section-title">费用明细</view>
    <view wx:for="{{order.fees}}" wx:key="fee_type" class="fee-row">
      <view class="fee-name">
        <view>{{item.name}}</view>
        <view class="fee-detail">{{item.detail}}</view>
      </view>
      <view class="fee-amount">¥{{item.amount}}</view>
    </view>
    <view class="fee-total">
      <view>合计</view>
      <view class="fee-total-amount">¥{{order.total_fee}}</view>
    </view>
    <view class="hint" style="margin: 16rpx 0 0;">费用由客服线下收取，小程序暂不支持在线支付</view>
    <view class="row" style="margin-top: 12rpx;" wx:if="{{service.wechat}}" bindtap="onCopyWechat">
      <view class="muted">客服微信</view>
      <view>{{service.wechat}} <text style="color: #2b6cff;">复制</text></view>
    </view>
  </view>

  <view class="card">
    <view class="section-title">物流轨迹</view>
    <view wx:if="{{!order.tracks.length}}" class="muted">暂无轨迹信息</view>
    <view wx:for="{{order.tracks}}" wx:key="index" style="padding: 12rpx 0; border-left: 2rpx solid #e0e0e0; padding-left: 20rpx; margin-left: 6rpx;">
      <view>{{item.status_text}}</view>
      <view class="muted">{{item.time}} {{item.location}}</view>
    </view>
  </view>

  <button wx:if="{{order.status === 'shipped'}}" class="btn-primary" bindtap="onConfirmReceived">确认收到包裹</button>
  <button wx:if="{{order.status === 'pending'}}" class="btn-outline" bindtap="onCloseOrder">关闭订单</button>
</view>
