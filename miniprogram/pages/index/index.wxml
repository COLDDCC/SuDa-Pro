<view class="container">
  <view class="card" wx:if="{{warehouse}}">
    <view class="section-title">我的日本仓地址</view>
    <view style="line-height: 1.6;">{{warehouse.address}}</view>
    <view class="muted" style="margin-top: 8rpx;">会员代码：{{warehouse.member_code}}（收货务必备注）</view>
    <view class="muted">{{warehouse.note}}</view>
    <button class="btn-outline" style="margin-top: 20rpx;" bindtap="onCopyAddress">复制收货地址</button>
  </view>

  <view class="card row">
    <button class="btn-primary" style="width: 45%;" bindtap="goForecast">+ 预报包裹</button>
    <button class="btn-outline" style="width: 45%;" bindtap="goPackages">查看我的包裹</button>
  </view>

  <view class="card">
    <view class="section-title">运费计算器</view>
    <view class="row">
      <input class="input" style="flex: 1; margin-right: 16rpx;" type="digit" placeholder="包裹重量(kg)"
        value="{{weightInput}}" bindinput="onWeightInput" />
      <button class="btn-outline" bindtap="onEstimateFee">计算</button>
    </view>
    <view wx:for="{{feeResult}}" wx:key="line_id" class="row" style="padding: 12rpx 0; border-top: 1rpx solid #f0f0f0;">
      <view>{{item.name}}</view>
      <view class="muted">{{item.days_min}}-{{item.days_max}}天</view>
      <view style="color: #2b6cff; font-weight: 600;">¥{{item.fee}}</view>
    </view>
  </view>

  <view class="card" wx:if="{{notices.length}}">
    <view class="section-title">公告</view>
    <view wx:for="{{notices}}" wx:key="id" style="margin-bottom: 12rpx;">
      <view style="font-weight: 600;">{{item.title}}</view>
      <view class="muted">{{item.content}}</view>
    </view>
  </view>
</view>
