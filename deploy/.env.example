# 复制成 .env 再填。.env 不要提交到 git（已在 .gitignore 里）。

# ---- 域名 ----
# 已经解析到这台服务器的域名。Caddy 用它申请 HTTPS 证书。
DOMAIN=api.example.com

# 允许打开 /admin 仓库后台的来源 IP，空格分隔。
# 填你自己办公/家里的固定公网 IP；不确定就先填 0.0.0.0/0 ::/0（等于不限制，仅靠 STAFF_KEY 把门）。
ADMIN_ALLOWED_IPS=0.0.0.0/0 ::/0

# ---- 密钥（下面两个都用这条命令各生成一个，不要复用同一个值）----
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# 签发用户登录 token 用。泄露 = 任何人都能伪造任意用户身份登录。
JWT_SECRET=

# 仓库/客服操作用（标记入库、标记发货、追加轨迹）。泄露 = 别人能乱改订单状态。
STAFF_KEY=

# ---- 增值服务定价 ----
# 入库拍照服务费，人民币元，按"每个包裹一次"收。
# 业务上谈的是 50 日元，这里填换算后的人民币价，汇率变了改这个值即可。
PHOTO_SERVICE_FEE=2.50

# 上传图片的大小上限（MB）。手机直出照片通常 3-8MB。
MAX_UPLOAD_MB=10

# ---- 微信小程序 ----
# 微信公众平台 -> 开发管理 -> 开发设置 里取。
# 这两个配齐后，本地联调用的 devLogin 会自动禁用。
WX_APPID=
WX_SECRET=
